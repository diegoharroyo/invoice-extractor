# Leave a value empty to turn that part off.

# Anthropic API key (console.anthropic.com), for the default --backend api.
ANTHROPIC_API_KEY=
# Google Sheet with "Invoices" and "Line items" tabs: service-account JSON file + the long id in the sheet URL.
# Share the sheet with the service account's email. Empty = only invoices.csv and line_items.csv are written.
GOOGLE_CREDENTIALS=
SHEET_ID=
